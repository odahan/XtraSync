<Window x:Class="XtraSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="XtraSync" Icon="Assets/XtraSync.ico" Width="1220" Height="900" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Button Content="Buy Me a Coffee" Click="OpenDonationPage"
                ToolTip="Open Buy Me a Coffee in your browser to support XtraSync"/>
        <Button Content="Help" Command="{Binding HelpCommand}" Margin="0"
                ToolTip="Open the bundled user guide in French or English. The HTML file is refreshed beside XtraSync.exe on every click."
                AutomationProperties.Name="Open user guide"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="XtraSync" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="FOLDER COMPARISON &amp; SYNCHRONIZATION" Foreground="#90A1B8" FontSize="11" Margin="1,4,0,0"/>
        <TextBlock Text="{Binding HelpError}" Foreground="#FCD34D" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18" IsEnabled="{Binding CanEdit}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="LEFT FOLDER" Foreground="#90A1B8" Margin="0,0,0,8"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseLeftCommand}" Margin="8,0,0,0" ToolTip="Choose the left folder"/>
          <ComboBox x:Name="LeftFolder" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding LeftFolderHistory}"
                    Text="{Binding LeftPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxDropDownHeight="360"
                    AllowDrop="True" PreviewDragEnter="FolderPreviewDragOver" PreviewDragOver="FolderPreviewDragOver" PreviewDrop="FolderPreviewDrop"
                    LostKeyboardFocus="FolderLostKeyboardFocus" PreviewKeyDown="FolderPreviewKeyDown"
                    ToolTip="Drop a folder from File Explorer, enter a path, or pick a recent folder" AutomationProperties.Name="Left folder"/>
        </DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="RIGHT FOLDER" Foreground="#90A1B8" Margin="0,0,0,8"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRightCommand}" Margin="8,0,0,0" ToolTip="Choose the right folder"/>
          <ComboBox x:Name="RightFolder" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding RightFolderHistory}"
                    Text="{Binding RightPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxDropDownHeight="360"
                    AllowDrop="True" PreviewDragEnter="FolderPreviewDragOver" PreviewDragOver="FolderPreviewDragOver" PreviewDrop="FolderPreviewDrop"
                    LostKeyboardFocus="FolderLostKeyboardFocus" PreviewKeyDown="FolderPreviewKeyDown"
                    ToolTip="Drop a folder from File Explorer, enter a path, or pick a recent folder" AutomationProperties.Name="Right folder"/>
        </DockPanel>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2">
      <WrapPanel Margin="0,0,0,18">
        <Button Content="Compare folders" Background="#265C98" Command="{Binding CompareCommand}"/>
        <Button Content="Mirror to right →" Command="{Binding MirrorRightCommand}"/>
        <Button Content="← Mirror to left" Command="{Binding MirrorLeftCommand}"/>
        <Button Content="Synchronize Both Way" Command="{Binding SynchronizeBothCommand}" ToolTip="Copy missing files and newer versions in either direction. Ambiguous conflicts are preserved and listed in the preview."/>
      </WrapPanel>
      <Border Background="{StaticResource PanelBrush}" Padding="14" CornerRadius="5" Margin="0,0,0,16">
        <WrapPanel IsEnabled="{Binding CanEdit}">
          <CheckBox Content="Subfolders included" IsChecked="{Binding IncludeSubfolders}"/>
          <CheckBox Content="Compare sizes" IsChecked="{Binding CompareSize}"/>
          <CheckBox Content="Compare timestamps" IsChecked="{Binding CompareTimestamps}"/>
          <TextBlock Text="Tolerance (seconds)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Text="{Binding Tolerance, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,18,0"/>
          <CheckBox Content="Ignore whole-hour time zone differences" IsChecked="{Binding IgnoreTimeZone}"/>
          <CheckBox Content="Delete excluded items from mirror destination" IsChecked="{Binding DeleteExcludedFromDestination}"
                    Margin="0,10,18,0" ToolTip="Off by default. Only for Mirror to right/left: excluded target items are listed for deletion in the review and removed after Apply mirror. Both-way synchronization always ignores exclusions without deleting them."/>
          <CheckBox Content="Compare folders after mirroring" IsChecked="{Binding CompareAfterMirroring}" Margin="0,10,18,0"
                    ToolTip="Scan both folders again after Mirror to right or Mirror to left to update the results table."/>
          <CheckBox Content="Create HTML report after this run" IsChecked="{Binding GenerateHtmlReport}" Margin="0,10,18,0"
                    ToolTip="Creates a timestamped HTML report beside XtraSync.exe, including errors, warnings and all statistics. This option resets after each comparison, mirror or synchronization."/>
          <StackPanel Orientation="Horizontal" Margin="0,10,18,0">
            <TextBlock Text="I/O read-error limit" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding ReadErrorLimit, UpdateSourceTrigger=PropertyChanged}" Width="48" AutomationProperties.Name="I/O read-error limit"
                     ToolTip="Stop after I/O read errors on this many distinct files during one run. Default: 10. Retries on the same file count once; successful reads do not reset the counter. Missing files, permissions and sharing locks are handled separately."/>
          </StackPanel>
        </WrapPanel>
      </Border>
      <DockPanel Margin="0,0,0,6" IsEnabled="{Binding CanEdit}">
        <TextBlock DockPanel.Dock="Left" Text="Exclusions" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button DockPanel.Dock="Right" Command="{Binding OpenFiltersCommand}" Margin="12,0,0,0"
                ToolTip="Edit upstream name filters" AutomationProperties.Name="Open name filters">
          <StackPanel Orientation="Horizontal">
            <Path Data="M 1,1 L 17,1 L 11,8 L 11,15 L 7,17 L 7,8 Z" Stroke="#E3E7EF" StrokeThickness="1.5"
                  Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Filters…" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ComboBox x:Name="ExclusionEntry" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="360"
                  ItemsSource="{Binding ExclusionHistory}" Text="{Binding Exclusions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  LostKeyboardFocus="ExclusionLostKeyboardFocus" PreviewKeyDown="ExclusionPreviewKeyDown" DropDownClosed="ExclusionDropDownClosed"
                  AutomationProperties.Name="Exclusion list"
                  AutomationProperties.HelpText="Separate patterns with semicolons. Bare patterns apply to files and folders; file: limits a pattern to files; folder: limits a pattern to folders. The last ten completed lines are retained without duplicates."
                  ToolTip="Example: *.tmp; file:*.bak; folder:bin. Saved automatically. Enter or leave the field to remember a complete line. Open Filters to edit one item per line."/>
      </DockPanel>
      <TextBlock Text="{Binding FilterSummary}" ToolTip="Filters run while scanning. Both-way synchronization always ignores excluded items on both sides."
                 Foreground="#90A1B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
    </StackPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*"/>
        <DataGridTextColumn Header="Comparison" Binding="{Binding Status}" Width="130"/>
        <DataGridTextColumn Header="Left size" Binding="{Binding LeftSize}" Width="95"/>
        <DataGridTextColumn Header="Right size" Binding="{Binding RightSize}" Width="95"/>
        <DataGridTextColumn Header="Left modified" Binding="{Binding LeftModified}" Width="158"/>
        <DataGridTextColumn Header="Right modified" Binding="{Binding RightModified}" Width="158"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,16,0,0">
      <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/>
          <Button Content="Restart" Command="{Binding RestartCommand}"/>
          <Button Content="Stop" Command="{Binding StopCommand}"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Phase}" TextWrapping="Wrap" Foreground="#90A1B8"/>
          <TextBlock Text="{Binding Statistics}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="10" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="{Binding CopyStatistics}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DeleteStatistics}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding FolderStatistics}" Foreground="#90A1B8" FontSize="11" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding TransferStatistics}" TextWrapping="Wrap" Foreground="#90A1B8" FontSize="11"/>
          <TextBlock Text="{Binding ProblemSummary}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#90A1B8"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Problems.HasWarnings}" Value="True"><Setter Property="Foreground" Value="#FCD34D"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
      <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,0,8" Foreground="#60A5FA"/>
      <TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFile}" Foreground="#90A1B8" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding RunFiles}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RunFiles}" Foreground="#90A1B8" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="Quick comparison uses sizes and timestamps. Mirror previews list copies, replacements, and deletions before applying them." Foreground="#90A1B8" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</Window>
