<Window x:Class="XtraSync.ReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="880" Height="780" MinWidth="700" MinHeight="650"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True"/>
      <Button Content="{Binding ApplyLabel}" IsEnabled="{Binding CanApply}" Click="Apply" Background="#265C98" Margin="0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Review changes before applying" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock Text="{Binding Roots}" TextWrapping="Wrap" Foreground="#B7C5DA" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <DataGrid ItemsSource="{Binding Groups}" IsReadOnly="True" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*"/>
          <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="90"/>
          <DataGridTextColumn Header="Total size" Binding="{Binding Size}" Width="140"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding FolderSummary}" Foreground="#B7C5DA" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding AffectedSummary}" Foreground="#90A1B8" Margin="0,0,0,12"/>
      <Expander Header="{Binding ConflictSummary}" Foreground="#B7C5DA" Margin="0,0,0,12">
        <ListBox ItemsSource="{Binding Conflicts}" MaxHeight="100" Background="#242831" Foreground="#E3E7EF"/>
      </Expander>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Actions}" IsReadOnly="True" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="120"/>
        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="155"/>
        <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*"/>
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
